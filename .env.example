# Local development. Copy to .env (git-ignored) and fill in your Stripe TEST keys.
# Never put live keys (sk_live_/pk_live_) here.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Printed by `stripe listen` (make dev / make listen, or `docker compose logs stripe`)
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional overrides (defaults shown). Inside Docker these are set by docker-compose.yml.
# DB_HOST=localhost
# DB_PORT=5433
# CELERY_BROKER_URL=redis://localhost:6380/0
# ALLOW_REGISTRATION=1
# STRIPE_API_BASE=http://127.0.0.1:9   # simulate a Stripe outage
