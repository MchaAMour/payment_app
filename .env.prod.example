# Production (docker-compose.prod.yml). Copy to .env.prod (git-ignored), chmod 600, fill in.
# Use Stripe TEST keys only: this is a demo.
DOMAIN=payments.example.com

DJANGO_SECRET_KEY=change-me   # python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_ALLOWED_HOSTS=payments.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://payments.example.com
ALLOW_REGISTRATION=0

DB_NAME=payments
DB_USER=payments
DB_PASSWORD=change-me

STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Signing secret of the webhook endpoint registered in the Stripe dashboard (see docs/DEPLOY.md)
STRIPE_WEBHOOK_SECRET=whsec_...
